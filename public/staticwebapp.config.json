{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/img/*", "/video/*", "/favicon.svg", "/*.{css,js,map,json,png,webp,svg,mp4,ico,txt,xml}"]
  },
  "mimeTypes": {
    ".webp": "image/webp",
    ".mp4": "video/mp4"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    {
      "comment": "Vite fingerprints these filenames, so a change always produces a new URL and they can be cached permanently. Azure's default is max-age=30 with must-revalidate, which forces a round-trip for every asset on every repeat visit.",
      "route": "/assets/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "comment": "Images and video are not fingerprinted, so cache for a day and revalidate rather than forever.",
      "route": "/img/*",
      "headers": { "Cache-Control": "public, max-age=86400" }
    },
    {
      "route": "/video/*",
      "headers": { "Cache-Control": "public, max-age=86400" }
    },
    {
      "route": "/sitemap.xml",
      "headers": { "Cache-Control": "public, max-age=3600" }
    },
    {
      "route": "/robots.txt",
      "headers": { "Cache-Control": "public, max-age=3600" }
    }
  ]
}
